# Optional settings for the website. Every one has a sensible default, so you only need a .env
# file to change one: copy this file to .env and edit it. Never put secret keys here; anything
# starting with VITE_ ends up in the public website code.

# The address the site is served from (used for sharing previews and search engines).
VITE_SITE_URL=http://localhost:5173

# Planned features, not used yet:
VITE_API_URL=http://localhost:4000/api/v1
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=
VITE_ANALYTICS_DOMAIN=

# Where the contact form sends messages: the contact API's Web app URL (see api/contact/README.md).
VITE_CONTACT_ENDPOINT=
